# Postgres (Neon: use the connection string from the project dashboard)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public URL of the frontend (CORS, QR codes, password reset links)
FRONTEND_URL=http://localhost:5173

# Long random string: openssl rand -base64 48
JWT_SECRET=

# Reverse proxies in front of the backend. 0 locally; set on Render after checking req.ip
TRUST_PROXY_HOPS=0

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Cloudinary (photo uploads)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Set both in production to use a webhook; leave empty locally to long-poll
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
